type vendor_lemonades_init, domain, vendor_executes_system_violators;
type vendor_lemonades_init_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_lemonades_init)

# Basic permissions for toolbox usage
allow vendor_lemonades_init { vendor_shell_exec vendor_toolbox_exec }:file { getattr execute execute_no_trans map };

# The entries ensures `sys.boot_completed` can be read.
allow vendor_lemonades_init boot_status_prop:file { read open getattr map };

# The entries ensures `cmd settings` can be used.
allow vendor_lemonades_init system_file:file { getattr execute read open execute_no_trans map };
allow vendor_lemonades_init servicemanager:binder { call };
allow vendor_lemonades_init settings_service:service_manager { find };
allow system_server vendor_lemonades_init:fd { use };
allow system_server vendor_lemonades_init:fifo_file { write };
allow vendor_lemonades_init system_server:binder { transfer };
allow system_server vendor_lemonades_init:binder { call };
