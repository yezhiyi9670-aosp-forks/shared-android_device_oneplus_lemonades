            <brightnessThresholdPoints>
                <brightnessThresholdPoint><threshold>0</threshold><percentage>0</percentage></brightnessThresholdPoint>
            </brightnessThresholdPoints>
        </darkeningThresholds>
    </displayBrightnessChangeThresholds>

